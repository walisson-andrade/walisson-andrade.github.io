---
import { getFullstackProjects } from "@/data/fullstack-projects";
import { loadAutomations } from "@/lib/loadAutomations";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import FullStackProjectCard from "./FullStackProjectCard.astro";
import AutomationCard from "./AutomationCard.astro";
import TechBadge from "./TechBadge.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const automations = loadAutomations(lang);
const fullstackProjects = getFullstackProjects(lang);

const tabs = [
  { id: "fullstack", label: t("projects.tab.fullstack"), count: fullstackProjects.length },
  { id: "automacoes", label: t("projects.tab.automations"), count: automations.length },
  { id: "data", label: t("projects.tab.data"), count: 0 },
] as const;
---

<section id="projetos" class="max-w-[1180px] mx-auto px-8 pt-14 pb-24">
  <SectionHeading tag={t("projects.tag")} title={t("projects.title")} subtitle={t("projects.subtitle")} />

  <div class="flex flex-wrap gap-3 mt-10" role="tablist">
    {
      tabs.map((tab, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-controls={`panel-${tab.id}`}
          data-tab={tab.id}
          class:list={[
            "tab-btn relative px-5 py-2.5 rounded-full font-body font-semibold text-sm transition-all duration-200 cursor-pointer",
            "border outline-none",
            i === 0 ? "bg-accent text-accent-ink border-accent" : "bg-surface text-ink-soft border-line hover:text-ink",
          ]}
        >
          {tab.label}
          {tab.count > 0 && <span class="ml-2 font-mono text-[11px] opacity-60">{tab.count}</span>}
        </button>
      ))
    }
  </div>

  <!-- Full Stack -->
  <div id="panel-fullstack" role="tabpanel" data-panel="fullstack" class="tab-panel mt-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[22px]">
      {fullstackProjects.map((project) => <FullStackProjectCard project={project} />)}
    </div>
  </div>

  <!-- Automações -->
  <div id="panel-automacoes" role="tabpanel" data-panel="automacoes" class="tab-panel mt-8 hidden">
    <div class="flex items-center gap-2.5 px-3.5 py-[9px] mb-6 bg-surface border border-line rounded-full w-fit">
      <span class="w-2 h-2 rounded-sm bg-accent"></span>
      <span class="font-mono text-xs text-ink-soft">{t("projects.confidentiality")}</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[22px]">
      {automations.map((auto) => <AutomationCard automation={auto} lang={lang} />)}
    </div>
  </div>

  <!-- Data & BI -->
  <div id="panel-data" role="tabpanel" data-panel="data" class="tab-panel mt-8 hidden">
    <div
      class="flex flex-col items-center justify-center py-20 text-center border border-dashed border-line rounded-[16px] bg-surface/60"
    >
      <div class="w-16 h-16 rounded-[14px] bg-accent-soft flex items-center justify-center text-accent mb-5">
        <svg width="28" height="28" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="4" y="14" width="4" height="8" rx="1"></rect>
          <rect x="11" y="9" width="4" height="13" rx="1"></rect>
          <rect x="18" y="5" width="4" height="17" rx="1"></rect>
        </svg>
      </div>
      <h3 class="font-body font-bold text-xl text-ink mb-2">{t("projects.data.title")}</h3>
      <p class="text-sm text-ink-soft max-w-md leading-relaxed mb-6">{t("projects.data.description")}</p>
      <div class="flex flex-wrap gap-[7px] justify-center">
        {["SQL", "Python", "Power BI", "PostgreSQL"].map((tech) => (
          <TechBadge name={tech} size="sm" />
        ))}
      </div>
      <span class="mt-6 font-mono text-xs text-ink-soft tracking-wide uppercase">
        {t("projects.data.comingSoon")}
      </span>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.tab;

      buttons.forEach((b) => {
        const isActive = b.dataset.tab === target;
        b.setAttribute("aria-selected", String(isActive));
        b.classList.toggle("bg-accent", isActive);
        b.classList.toggle("text-accent-ink", isActive);
        b.classList.toggle("border-accent", isActive);
        b.classList.toggle("bg-surface", !isActive);
        b.classList.toggle("text-ink-soft", !isActive);
        b.classList.toggle("border-line", !isActive);
      });

      panels.forEach((p) => {
        p.classList.toggle("hidden", p.dataset.panel !== target);
      });
    });
  });
</script>

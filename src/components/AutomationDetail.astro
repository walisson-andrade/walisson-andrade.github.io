---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Automation } from "@/lib/types";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { getSite } from "@/data/site";
import TechBadge from "@/components/TechBadge.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  automation: Automation;
  lang?: Lang;
}

const { automation, lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);
const homeHref = `/${lang}`;
const projectsHref = `/${lang}#projetos`;
const currentPath = `/automacoes/${automation.slug}`;
---

<BaseLayout lang={lang} title={`${automation.titulo} | ${site.name}`} description={automation.descricao}>
  <header class="sticky top-0 z-60 backdrop-blur-md bg-bg/85 border-b border-line">
    <div class="max-w-[1180px] mx-auto px-8 py-4 flex items-center justify-between">
      <a href={homeHref} class="flex items-center gap-2.5 no-underline">
        <span class="w-2.5 h-2.5 rounded-[3px] bg-accent inline-block"></span>
        <span class="font-display italic text-lg text-ink tracking-tight">{site.name}</span>
      </a>
      <div class="flex items-center gap-5">
        <a
          href={projectsHref}
          class="no-underline inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-soft hover:text-ink transition-colors"
        >
          <span>←</span> {t("nav.back")}
        </a>
        <LanguageSwitcher lang={lang} path={currentPath} />
        <ThemeToggle />
      </div>
    </div>
  </header>

  <main class="max-w-[860px] mx-auto px-8 pt-16 pb-24">
    <div class="mb-10">
      <span
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-soft rounded-full font-mono text-[11px] font-medium text-accent mb-5"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        {t("automation.badge")}
      </span>
      <h1 class="font-display font-semibold text-[clamp(28px,5vw,40px)] leading-[1.15] tracking-tight text-ink">
        {automation.titulo}
      </h1>
      <p class="text-lg text-ink-soft mt-4 leading-relaxed max-w-[700px]">{automation.descricao}</p>
    </div>

    {
      automation.prints.length > 0 && (
        <div class="flex flex-col gap-4 mb-12">
          {automation.prints.map((print, i) => (
            <div class="rounded-[16px] overflow-hidden border border-line bg-surface shadow-soft">
              <Image
                src={print}
                alt={`${automation.titulo} — ${i + 1}`}
                class="w-full h-auto"
                widths={[600, 900]}
                sizes="(max-width: 860px) 100vw, 860px"
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-12">
      <div class="p-6 bg-surface border border-line rounded-[16px] shadow-soft">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-accent font-medium">
          {t("automation.problem")}
        </span>
        <p class="text-[15px] text-ink-soft leading-relaxed mt-2">{automation.problema}</p>
      </div>
      <div class="p-6 bg-surface border border-line rounded-[16px] shadow-soft">
        <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-accent font-medium">
          {t("automation.result")}
        </span>
        <p class="text-[15px] text-ink-soft leading-relaxed mt-2">{automation.resultado}</p>
      </div>
    </div>

    <div class="p-6 bg-bg-alt border-l-[3px] border-l-accent rounded-[16px] mb-12">
      <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-ink font-medium">
        {t("automation.impact")}
      </span>
      <p class="font-display font-semibold text-xl text-ink mt-2 leading-snug">{automation.metrica}</p>
    </div>

    {
      automation.destaques.length > 0 && (
        <div class="mb-12">
          <h2 class="font-body font-bold text-lg text-ink mb-4">{t("automation.highlights")}</h2>
          <ul class="flex flex-col gap-2.5">
            {automation.destaques.map((d) => (
              <li class="flex items-start gap-3 text-[15px] text-ink-soft leading-relaxed">
                <span class="text-accent mt-0.5 shrink-0">↗</span>
                {d}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div>
      <h2 class="font-body font-bold text-lg text-ink mb-4">{t("automation.tech")}</h2>
      <div class="flex flex-wrap gap-2">
        {automation.tecnologias.map((tech) => <TechBadge name={tech} />)}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-line">
      <div class="flex items-center gap-2 font-mono text-xs text-ink-soft">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        {t("automation.confidentiality")}
      </div>
    </div>
  </main>
</BaseLayout>

---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Automation } from "@/lib/types";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { getSite } from "@/data/site";
import ThemeToggle from "@/components/ThemeToggle.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  automation: Automation;
  index: number;
  lang?: Lang;
}

const { automation, index, lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const site = getSite(lang);
const homeHref = `/${lang}`;
const projectsHref = `/${lang}#automacoes`;
const currentPath = `/automacoes/${automation.slug}`;
const idx = String(index).padStart(2, "0");
---

<BaseLayout lang={lang} title={`${automation.titulo} | ${site.name}`} description={automation.descricao}>
  <header class="sticky top-0 z-60 border-b border-line bg-bg/90 backdrop-blur-md">
    <div class="max-w-[1180px] mx-auto px-6 md:px-8 h-14 flex items-center justify-between">
      <a href={homeHref} class="no-underline font-mono text-[12px] uppercase tracking-[0.14em] text-ink">
        {site.name}
      </a>
      <div class="flex items-center gap-5">
        <a
          href={projectsHref}
          class="no-underline inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-soft hover:text-accent transition-colors"
        >
          <span>←</span> {t("nav.back")}
        </a>
        <LanguageSwitcher lang={lang} path={currentPath} />
        <ThemeToggle />
      </div>
    </div>
  </header>

  <main class="relative">
    <div class="max-w-[1180px] mx-auto px-6 md:px-8 pt-16 md:pt-24 pb-6 relative overflow-hidden">
      <span
        class="pointer-events-none select-none absolute -top-4 md:-top-10 right-0 font-display font-semibold text-[clamp(100px,18vw,220px)] leading-none text-ink/[0.05] z-0"
        aria-hidden="true"
      >
        {idx}
      </span>
      <div class="relative z-10 max-w-[760px]">
        <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-accent">{t("automation.badge")}</span>
        <h1
          class="font-display font-semibold text-[clamp(30px,5vw,52px)] leading-[1.08] tracking-[-0.015em] text-ink mt-4"
        >
          {automation.titulo}
        </h1>
        <p class="text-lg text-ink-soft mt-4 leading-relaxed">{automation.descricao}</p>
      </div>
    </div>

    {
      automation.prints.length > 0 && (
        <div class="mt-6 md:mt-10 flex flex-col gap-px bg-line">
          {automation.prints.map((print, i) => (
            <div class="bg-surface">
              <Image
                src={print}
                alt={`${automation.titulo} — ${i + 1}`}
                class="w-full h-auto"
                widths={[800, 1200, 1600]}
                sizes="100vw"
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="max-w-[1180px] mx-auto px-6 md:px-8 py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 max-w-[860px]">
        <div>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-accent">
            {t("automation.problem")}
          </span>
          <p class="text-[15px] text-ink-soft leading-relaxed mt-2">{automation.problema}</p>
        </div>
        <div>
          <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-accent">
            {t("automation.result")}
          </span>
          <p class="text-[15px] text-ink-soft leading-relaxed mt-2">{automation.resultado}</p>
        </div>
      </div>

      <div class="mt-12 md:mt-14 pl-5 border-l-2 border-accent max-w-[600px]">
        <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink">{t("automation.impact")}</span>
        <p class="font-display font-semibold text-2xl text-ink mt-1.5 leading-snug">{automation.metrica}</p>
      </div>

      {
        automation.destaques.length > 0 && (
          <div class="mt-12 md:mt-14 max-w-[700px]">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink">
              {t("automation.highlights")}
            </span>
            <ul class="mt-3 flex flex-col gap-2.5">
              {automation.destaques.map((d) => (
                <li class="text-[15px] text-ink-soft leading-relaxed pl-4 border-l border-line">{d}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mt-12 md:mt-14 pt-6 border-t border-line">
        <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink-soft">{t("automation.tech")}</span>
        <p class="font-mono text-[12.5px] text-ink-soft mt-2">{automation.tecnologias.join(" · ")}</p>
      </div>

      <p class="mt-16 font-mono text-[11px] text-ink-soft/70">{t("automation.confidentiality")}</p>
    </div>
  </main>
</BaseLayout>

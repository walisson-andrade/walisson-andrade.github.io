---
import { getExperiences } from "@/data/experience";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const experiences = getExperiences(lang);
const t = useTranslations(lang);
---

<section id="experiencia" class="max-w-[1180px] mx-auto px-8 py-24">
  <SectionHeading tag={t("experience.tag")} title={t("experience.title")} />

  <div class="relative mt-12 max-w-[760px]">
    <div class="absolute left-[5px] top-[6px] bottom-[30px] w-px bg-line"></div>

    {
      experiences.map((exp) => (
        <div class="relative pl-[34px] pb-[38px] last:pb-0">
          <div
            class:list={[
              "absolute left-0 top-1 w-[13px] h-[13px] rounded-full border-2",
              exp.isCurrent ? "bg-teal border-teal" : "bg-surface border-line",
            ]}
          />
          <div
            class:list={[
              "font-mono text-[12px] font-medium mb-[7px] inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full border",
              exp.isCurrent ? "bg-teal/10 text-teal border-teal/30" : "bg-surface text-ink-soft border-line",
            ]}
          >
            {exp.period}
          </div>
          <div class="font-body font-bold text-[20px] text-ink">
            {exp.company} <span class="font-normal text-base text-ink-soft">· {exp.role}</span>
          </div>
          <p class="text-[14.5px] leading-relaxed text-ink-soft mt-[9px] max-w-[560px]">{exp.description}</p>
        </div>
      ))
    }
  </div>
</section>

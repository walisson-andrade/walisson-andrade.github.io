---
import { getFullstackProjects } from "@/data/fullstack-projects";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import CaseStudyBlock from "./CaseStudyBlock.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const fullstackProjects = getFullstackProjects(lang);
const t = useTranslations(lang);
---

<section id="projetos" class="max-w-[1180px] mx-auto px-6 md:px-8 py-20 md:py-28">
  <SectionHeading tag={t("projects.tag")} title={t("projects.title")} subtitle={t("projects.subtitle")} />

  <div class="mt-4">
    {
      fullstackProjects.map((project, i) => (
        <CaseStudyBlock project={project} isFirst={i === 0} />
      ))
    }
  </div>
</section>

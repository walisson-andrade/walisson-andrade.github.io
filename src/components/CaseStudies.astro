---
import { getFullstackProjects } from "@/data/fullstack-projects";
import { getSiteProjects } from "@/data/site-projects";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import CaseStudyBlock from "./CaseStudyBlock.astro";
import SiteProjectCard from "./SiteProjectCard.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const fullstackProjects = getFullstackProjects(lang);
const siteProjects = getSiteProjects(lang);
const t = useTranslations(lang);
---

<section id="projetos" class="max-w-[1180px] mx-auto px-6 md:px-8 py-20 md:py-28">
  <SectionHeading tag={t("projects.tag")} title={t("projects.title")} subtitle={t("projects.subtitle")} />

  <div class="mt-12 md:mt-14 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-start">
    {
      fullstackProjects.map((project, i) => (
        <CaseStudyBlock project={project} index={i} />
      ))
    }
  </div>

  <div class="mt-16 md:mt-20 flex items-center gap-4" data-reveal>
    <span class="shrink-0 font-mono text-[11px] tracking-[0.16em] uppercase text-accent">
      {t("siteProjects.tag")}
    </span>
    <span class="h-px flex-1 max-w-[72px] bg-line"></span>
  </div>
  <h3 class="font-display font-semibold text-[clamp(22px,3vw,28px)] leading-[1.15] text-ink mt-4" data-reveal>
    {t("siteProjects.title")}
  </h3>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-start">
    {
      siteProjects.map((project, i) => (
        <SiteProjectCard project={project} visitLabel={t("siteProjects.visit")} index={i} />
      ))
    }
  </div>
</section>

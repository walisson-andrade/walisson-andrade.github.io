---
import { Image } from "astro:assets";
import { getSite } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import photo from "@/assets/leticia.jpg";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
---

<section id="top" class="relative overflow-hidden">
  <div class="hero-dots"></div>

  <div
    class="max-w-[1180px] mx-auto px-8 pt-24 md:pt-32 pb-20 md:pb-28 relative flex flex-col md:flex-row items-start md:items-center gap-12 md:gap-16"
  >
    <div class="flex-1">
      <div class="reveal-0">
        <span
          class="inline-flex items-center gap-[9px] px-3.5 py-[7px] bg-surface border border-line rounded-full font-mono text-[11px] uppercase tracking-[0.1em] text-ink-soft"
        >
          <span class="w-[7px] h-[7px] rounded-full bg-teal pulse-dot"></span>
          {site.confidentiality}
        </span>
      </div>

      <h1
        class="reveal-1 font-display font-semibold text-[clamp(42px,8.5vw,80px)] leading-[1.02] tracking-[-0.015em] text-ink mt-6 md:mt-7 max-w-[880px]"
      >
        {site.heroTitleMain}
        <span class="ink-accent block sm:inline">{site.heroTitleHighlight}</span>
      </h1>

      <p
        class="reveal-2 text-lg md:text-xl leading-relaxed text-ink-soft mt-6 md:mt-[26px] max-w-[600px]"
      >
        {site.subtitle}
      </p>

      <div class="reveal-3 flex items-center gap-4 mt-8 md:mt-[42px] flex-wrap">
        <a
          href="#contato"
          class="press no-underline inline-flex items-center gap-[9px] px-6 md:px-7 py-[15px] rounded-full bg-accent text-accent-ink text-[15px] font-body font-semibold shadow-soft"
        >
          {t("nav.cta")} <span class="text-base">→</span>
        </a>
        <a
          href="#projetos"
          class="press no-underline inline-flex items-center px-6 md:px-7 py-[15px] rounded-full border border-line bg-surface text-ink text-[15px] font-body font-semibold hover:border-accent transition-colors"
        >
          {t("stacks.cta")}
        </a>
        <span class="hidden sm:inline-flex items-center gap-2 ml-1.5 text-[13px] text-ink-soft font-mono">
          <span class="w-2 h-2 rounded-full bg-teal"></span>
          {t("hero.available")}
        </span>
      </div>
    </div>

    <div class="reveal-4 shrink-0 hidden md:block relative">
      <div class="hero-glow w-[260px] h-[260px] -top-6 -right-6"></div>
      <div class="w-[200px] h-[200px] lg:w-[240px] lg:h-[240px] rounded-[20px] overflow-hidden border border-line shadow-soft bg-surface relative">
        <Image
          src={photo}
          alt={site.name}
          width={480}
          height={480}
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>

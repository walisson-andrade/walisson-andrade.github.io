---
import { loadAutomations } from "@/lib/loadAutomations";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import AutomationLogEntry from "./AutomationLogEntry.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const automations = loadAutomations(lang);
---

<section id="automacoes" class="max-w-[1180px] mx-auto px-6 md:px-8 py-20 md:py-28 border-t border-line">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <SectionHeading tag={t("automations.tag")} title={t("automations.title")} />
    <p class="font-mono text-[11px] leading-relaxed text-ink-soft/70 max-w-[280px] md:text-right">
      {t("projects.confidentiality")}
    </p>
  </div>

  <div class="mt-12 md:mt-14 border-t border-line">
    {
      automations.map((auto, i) => (
        <AutomationLogEntry automation={auto} index={i + 1} lang={lang} />
      ))
    }
  </div>
</section>

---
import type { SiteProject } from "@/lib/types";

interface Props {
  project: SiteProject;
  visitLabel: string;
  index?: number;
}

const { project, visitLabel, index = 0 } = Astro.props;
const delay = (index % 4) * 90;
const displayUrl = project.url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<article
  class="card-hover group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface"
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <div
    class="relative aspect-[16/10] flex items-end p-6 md:p-7 overflow-hidden"
    style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 22%, var(--color-bg-alt)), color-mix(in srgb, var(--color-pink) 18%, var(--color-bg-alt)));"
  >
    <span
      class="pointer-events-none select-none absolute -top-4 -right-2 font-display font-bold text-[120px] leading-none text-ink/[0.06]"
      aria-hidden="true"
    >
      {project.number}
    </span>
    <span class="relative font-display italic text-xl md:text-2xl leading-tight text-ink-soft">
      {project.segment}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6 md:p-7">
    <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent">{project.segment}</p>
    <h3 class="font-display font-bold text-xl md:text-[22px] leading-[1.2] text-ink mt-2">
      {project.title}
    </h3>

    <p class="mt-4 text-[13.5px] text-ink-soft leading-relaxed border-t border-line pt-4">
      {project.description}
    </p>

    <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.06em] text-ink-soft">
      {project.technologies.join(" · ")}
    </p>

    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex w-fit items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.1em] text-accent hover:text-pink transition-colors"
    >
      {visitLabel}
      <span aria-hidden="true">↗</span>
      <span class="sr-only">{" "}({displayUrl})</span>
    </a>
  </div>
</article>

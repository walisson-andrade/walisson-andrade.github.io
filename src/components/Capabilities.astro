---
import { getStacks } from "@/data/stacks";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const stacks = getStacks(lang);
const t = useTranslations(lang);
---

<section id="skills" class="max-w-[1180px] mx-auto px-6 md:px-8 py-20 md:py-28">
  <SectionHeading tag={t("stacks.tag")} title={t("stacks.title")} />

  <div class="mt-12 md:mt-14">
    {
      stacks.map((stack, i) => (
        <div
          class:list={[
            "grid grid-cols-[52px_1fr] md:grid-cols-[120px_1fr] gap-5 md:gap-10 py-8 md:py-10",
            i > 0 && "border-t border-line",
          ]}
        >
          <span class="font-display font-semibold text-[clamp(30px,5vw,54px)] leading-none text-ink-soft/35">
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h3 class="font-body font-bold text-xl md:text-2xl text-ink">{stack.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft max-w-[600px]">{stack.description}</p>
            <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.05em] text-ink-soft/80">
              {stack.technologies.join(" · ")}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

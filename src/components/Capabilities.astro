---
import { getStacks } from "@/data/stacks";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const stacks = getStacks(lang);
const t = useTranslations(lang);
---

<section id="skills" class="max-w-[1180px] mx-auto px-6 md:px-8 py-20 md:py-28">
  <SectionHeading tag={t("stacks.tag")} title={t("stacks.title")} />

  <div class="mt-12 md:mt-14 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
    {
      stacks.map((stack, i) => (
        <div
          class="card-hover rounded-2xl border border-line bg-surface p-6 md:p-7"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <span class="font-display font-bold text-[clamp(28px,4vw,40px)] leading-none text-accent/30">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="font-body font-bold text-lg md:text-xl text-ink mt-4">{stack.title}</h3>
          <p class="mt-3 text-[14.5px] leading-relaxed text-ink-soft">{stack.description}</p>
          <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.05em] text-ink-soft">
            {stack.technologies.join(" · ")}
          </p>
        </div>
      ))
    }
  </div>
</section>

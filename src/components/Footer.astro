---
import { getSite } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="max-w-[1180px] mx-auto px-6 md:px-8 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-[11px] text-ink-soft/70"
  >
    <p>{site.name} · © {year} · {t("footer.tagline")}</p>
    <p>{t("footer.confidentiality")}</p>
  </div>
</footer>

---
import type { FullStackProject } from "@/lib/types";
import TechBadge from "./TechBadge.astro";

interface Props {
  project: FullStackProject;
}

const { project } = Astro.props;
---

<div class="card-hover bg-surface border border-line rounded-[16px] p-[30px] flex flex-col shadow-soft">
  <div class="flex items-center justify-between">
    <span
      class="inline-flex px-[11px] py-[5px] bg-accent-soft rounded-full font-mono text-[11px] font-medium tracking-wide text-accent"
    >
      {project.segment}
    </span>
    <span class="font-display text-[20px] text-ink-soft leading-none">{project.number}</span>
  </div>

  <h3 class="font-body font-bold text-[21px] leading-[1.25] text-ink mt-[18px] mb-4">
    {project.title}
  </h3>

  <div class="flex flex-col gap-[9px] mb-5">
    {
      project.metrics.map((metric) => (
        <div class="flex items-start gap-2.5">
          <span class="text-accent text-sm mt-0.5">{metric.icon}</span>
          <span class="text-[14.5px] text-ink-soft leading-[1.45]">
            {metric.text}
            <strong class="text-ink font-semibold">{metric.highlight}</strong>
          </span>
        </div>
      ))
    }
  </div>

  <div class="flex flex-wrap gap-[7px] mb-5">
    {project.technologies.map((tech) => <TechBadge name={tech} />)}
  </div>

  <div class="mt-auto flex flex-col gap-[5px] p-3.5 px-4 bg-bg-alt border-l-[3px] border-l-accent rounded-[8px]">
    <span class="font-mono text-[10.5px] tracking-[0.1em] uppercase text-ink font-medium">
      {project.technicalHighlight.label}
    </span>
    <span class="text-[13.5px] text-ink-soft leading-[1.45]">
      {project.technicalHighlight.description}
    </span>
  </div>
</div>

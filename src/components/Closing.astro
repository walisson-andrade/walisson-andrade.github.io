---
import { getSite } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
---

<section id="contato" class="relative overflow-hidden border-t border-line">
  <div class="hero-glow w-[600px] h-[400px] -bottom-[220px] left-1/2 -translate-x-1/2"></div>

  <div class="max-w-[900px] mx-auto px-6 md:px-8 py-24 md:py-32 relative">
    <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-accent">{t("cta.tag")}</span>
    <h2
      class="font-display font-semibold text-[clamp(34px,6vw,64px)] leading-[1.05] tracking-[-0.015em] text-ink mt-5 max-w-[820px]"
    >
      {site.cta} <span class="ink-accent">{t("cta.highlight")}</span>
    </h2>

    <div class="mt-12 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10 font-mono text-sm">
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener"
        class="no-underline inline-flex items-center gap-2 text-ink border-b border-line hover:border-accent hover:text-accent transition-colors pb-1 w-fit"
      >
        LinkedIn <span>→</span>
      </a>
      <a
        href={site.whatsappLink}
        target="_blank"
        rel="noopener"
        class="no-underline inline-flex items-center gap-2 text-ink border-b border-line hover:border-accent hover:text-accent transition-colors pb-1 w-fit"
      >
        WhatsApp <span class="text-ink-soft">{site.whatsapp}</span>
      </a>
      <a
        href={`mailto:${site.email}`}
        class="no-underline inline-flex items-center gap-2 text-ink border-b border-line hover:border-accent hover:text-accent transition-colors pb-1 w-fit"
      >
        {site.email}
      </a>
    </div>
  </div>
</section>

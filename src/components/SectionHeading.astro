---
interface Props {
  tag: string;
  title: string;
  subtitle?: string;
}

const { tag, title, subtitle } = Astro.props;
---

<div>
  <span
    class="inline-block font-mono text-[11px] tracking-[0.14em] uppercase text-accent bg-accent-soft border border-accent/20 px-2.5 py-1 rounded-full"
  >
    {tag}
  </span>
  <h2
    class="font-display font-semibold text-[clamp(30px,5vw,44px)] leading-[1.08] tracking-[-0.01em] text-ink mt-4"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-base text-ink-soft mt-3.5 max-w-[560px] leading-relaxed">{subtitle}</p>
    )
  }
</div>

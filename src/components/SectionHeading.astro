---
interface Props {
  tag: string;
  title: string;
  subtitle?: string;
}

const { tag, title, subtitle } = Astro.props;
---

<div>
  <div class="flex items-center gap-4">
    <span class="shrink-0 font-mono text-[11px] tracking-[0.16em] uppercase text-accent">
      {tag}
    </span>
    <span class="h-px flex-1 max-w-[72px] bg-line"></span>
  </div>
  <h2
    class="font-display font-semibold text-[clamp(30px,5vw,44px)] leading-[1.08] tracking-[-0.01em] text-ink mt-4"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-base text-ink-soft mt-3.5 max-w-[560px] leading-relaxed">{subtitle}</p>
    )
  }
</div>

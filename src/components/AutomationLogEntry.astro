---
import { getTechIconSvg } from "@/lib/techIcons";
import type { Automation } from "@/lib/types";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

interface Props {
  automation: Automation;
  index: number;
  lang?: Lang;
}

const { automation, index, lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const idx = String(index).padStart(2, "0");
const href = `/${lang}/automacoes/${automation.slug}`;
const icons = automation.tecnologias
  .map((tech) => ({ tech, svg: getTechIconSvg(tech) }))
  .filter((entry): entry is { tech: string; svg: string } => Boolean(entry.svg))
  .slice(0, 6);
---

<details class="group border-b border-line">
  <summary
    class="list-none flex flex-wrap md:flex-nowrap items-center gap-3 md:gap-5 py-4 md:py-5 cursor-pointer select-none [&::-webkit-details-marker]:hidden"
  >
    <span class="font-mono text-[12px] text-ink-soft/60 w-7 shrink-0">{idx}</span>
    <span class="font-mono text-[13px] md:text-[14px] text-ink font-medium shrink-0 md:w-[300px] md:pr-4">
      {automation.titulo}
    </span>
    <span class="hidden md:block text-[12.5px] text-ink-soft flex-1 truncate">{automation.metrica}</span>
    <span class="hidden sm:flex items-center gap-2 shrink-0">
      {
        icons.map(({ tech, svg }) => (
          <span class="w-[14px] h-[14px] text-ink-soft/70" title={tech} set:html={svg} />
        ))
      }
    </span>
    <span
      class="ml-auto md:ml-0 font-mono text-base leading-none text-ink-soft/50 shrink-0 transition-transform duration-200 group-open:rotate-45"
      aria-hidden="true"
    >
      +
    </span>
  </summary>

  <div class="pb-6 md:pl-12 grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
    <p class="md:hidden text-[12.5px] text-ink-soft -mt-2">{automation.metrica}</p>
    <div>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-accent">{t("automation.problem")}</span>
      <p class="text-[13.5px] text-ink-soft leading-relaxed mt-1.5">{automation.problema}</p>
    </div>
    <div>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-accent">{t("automation.result")}</span>
      <p class="text-[13.5px] text-ink-soft leading-relaxed mt-1.5">{automation.resultado}</p>
    </div>
    {
      automation.destaques.length > 0 && (
        <div class="md:col-span-2">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-ink">
            {t("automation.highlights")}
          </span>
          <ul class="mt-1.5 flex flex-col gap-1.5">
            {automation.destaques.map((d) => (
              <li class="text-[13px] text-ink-soft leading-relaxed pl-4 border-l border-line">{d}</li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="md:col-span-2 flex flex-wrap items-center justify-between gap-3 pt-2">
      <p class="font-mono text-[11px] text-ink-soft/70">{automation.tecnologias.join(" · ")}</p>
      <a
        href={href}
        class="no-underline inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.06em] text-accent border-b border-accent/40 hover:border-accent pb-0.5 w-fit"
      >
        {t("projects.viewDetails")} →
      </a>
    </div>
  </div>
</details>

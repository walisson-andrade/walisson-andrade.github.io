---
import { Image } from "astro:assets";
import { getSite } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import photo from "@/assets/leticia.jpg";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
---

<section id="top" class="relative overflow-hidden min-h-[86vh] md:min-h-[92vh] flex items-center border-b border-line">
  <div class="hero-glow w-[520px] h-[520px] -top-40 -right-40"></div>

  <div class="relative z-10 max-w-[1180px] mx-auto px-6 md:px-8 w-full py-28 md:py-0 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-center">
    <div class="md:col-span-7">
      <h1
        class="reveal-0 font-display font-bold text-[clamp(42px,7.5vw,86px)] leading-[1.02] tracking-[-0.02em] text-ink"
      >
        <span class="block">{site.heroTitleMain}</span>
        <span class="ink-accent block">{site.heroTitleHighlight}</span>
      </h1>

      <p class="reveal-1 text-lg md:text-xl leading-relaxed text-ink-soft mt-7 md:mt-8 max-w-[480px]">
        {site.subtitle}
      </p>

      <a
        href="#projetos"
        class="btn-fill reveal-2 mt-9 md:mt-10 inline-flex items-center gap-2 no-underline rounded-full px-6 py-3.5 font-mono text-sm uppercase tracking-[0.08em] hover:opacity-90 transition-opacity"
      >
        {t("opening.workLink")} <span aria-hidden="true">→</span>
      </a>

      <p class="reveal-3 mt-10 font-mono text-[11px] leading-relaxed text-ink-soft">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-teal pulse-dot mr-1.5 align-middle"></span>
        {site.confidentiality} — {t("hero.available")}
      </p>
    </div>

    <div class="reveal-4 md:col-span-5">
      <div class="portrait-frame aspect-[4/5] overflow-hidden">
        <div class="portrait-glow"></div>
        <Image src={photo} alt="" width={900} height={1125} class="w-full h-full object-cover object-top" />
      </div>
    </div>
  </div>
</section>

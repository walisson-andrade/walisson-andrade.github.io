---
import { Image } from "astro:assets";
import { getSite } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import photo from "@/assets/leticia.jpg";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const site = getSite(lang);
const t = useTranslations(lang);
---

<section id="top" class="relative overflow-hidden min-h-[86vh] md:min-h-[92vh] flex items-center border-b border-line">
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-y-0 right-0 w-full md:w-[56%]">
      <Image
        src={photo}
        alt=""
        width={1200}
        height={1500}
        class="duotone-photo w-full h-full object-cover object-top opacity-90 md:opacity-100"
      />
      <div class="duotone-overlay absolute inset-0"></div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-bg via-bg/75 to-transparent md:via-bg/15 md:to-transparent"
      >
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-transparent md:hidden"></div>
    </div>
  </div>

  <div class="relative z-10 max-w-[1180px] mx-auto px-6 md:px-8 w-full py-28 md:py-0">
    <div class="max-w-[760px]">
      <h1
        class="reveal-0 font-display font-semibold text-[clamp(46px,9vw,104px)] leading-[0.98] tracking-[-0.02em] text-ink"
      >
        <span class="block">{site.heroTitleMain}</span>
        <span class="ink-accent block">{site.heroTitleHighlight}</span>
      </h1>

      <p class="reveal-1 text-lg md:text-xl leading-relaxed text-ink-soft mt-7 md:mt-8 max-w-[480px]">
        {site.subtitle}
      </p>

      <a
        href="#projetos"
        class="reveal-2 mt-9 md:mt-10 inline-flex items-center gap-2 no-underline font-mono text-sm uppercase tracking-[0.08em] text-ink border-b border-ink pb-1 hover:text-accent hover:border-accent transition-colors"
      >
        {t("opening.workLink")} <span>→</span>
      </a>
    </div>
  </div>

  <p
    class="reveal-3 absolute bottom-6 md:bottom-8 left-6 md:left-8 right-6 md:right-auto md:max-w-[400px] z-10 font-mono text-[11px] leading-relaxed text-ink-soft/80"
  >
    <span class="inline-block w-1.5 h-1.5 rounded-full bg-teal pulse-dot mr-1.5 align-middle"></span>
    {site.confidentiality} — {t("hero.available")}
  </p>
</section>

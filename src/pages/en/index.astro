---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSite } from "@/data/site";
import Masthead from "@/components/Masthead.astro";
import Opening from "@/components/Opening.astro";
import Capabilities from "@/components/Capabilities.astro";
import CaseStudies from "@/components/CaseStudies.astro";
import AutomationLog from "@/components/AutomationLog.astro";
import ImpactTicker from "@/components/ImpactTicker.astro";
import ExperienceTable from "@/components/ExperienceTable.astro";
import Closing from "@/components/Closing.astro";
import Footer from "@/components/Footer.astro";

const site = getSite("en");
---

<BaseLayout lang="en" title={site.title} description={site.subtitle}>
  <Masthead lang="en" />
  <Opening lang="en" />
  <Capabilities lang="en" />
  <CaseStudies lang="en" />
  <AutomationLog lang="en" />
  <ImpactTicker lang="en" />
  <ExperienceTable lang="en" />
  <Closing lang="en" />
  <Footer lang="en" />
</BaseLayout>
